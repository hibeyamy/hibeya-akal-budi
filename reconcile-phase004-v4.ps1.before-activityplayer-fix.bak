Write-Step "Reconciling learner runtime-profile service"

Backup-File $deviceServicePath
$deviceService = Get-Text $deviceServicePath

if (-not $deviceService.Contains("export type LearnerAgeBand")) {
  $deviceService += @"

export type LearnerAgeBand =
  | "2-3"
  | "3-4"
  | "4-5"
  | "5-6";


export type LearnerLanguage =
  | "ms"
  | "en";


export interface LearnerRuntimeProfile {
  childId: string;

  ageBand:
    LearnerAgeBand;

  preferredLanguage:
    LearnerLanguage;
}
"@
}

if (-not $deviceService.Contains("getLearnerRuntimeProfile")) {
  $deviceService += @"

export async function getLearnerRuntimeProfile(
  deviceId: string,
  deviceToken: string
): Promise<LearnerRuntimeProfile> {

  const {
    data,
    error
  } =
    await supabase.rpc(
      "get_learner_runtime_profile",
      {
        p_device_id:
          deviceId,

        p_device_token:
          deviceToken
      }
    );

  if (error) {
    throw error;
  }

  const result =
    data?.[0];

  if (!result) {
    throw new Error(
      "Profil pembelajaran tidak ditemui."
    );
  }

  if (
    !isLearnerAgeBand(
      result.age_band
    )
  ) {
    throw new Error(
      "Julat umur pembelajaran tidak sah."
    );
  }

  if (
    !isLearnerLanguage(
      result.preferred_language
    )
  ) {
    throw new Error(
      "Bahasa pembelajaran tidak sah."
    );
  }

  return {
    childId:
      result.child_id,

    ageBand:
      result.age_band,

    preferredLanguage:
      result.preferred_language
  };
}


function isLearnerAgeBand(
  value: string
): value is LearnerAgeBand {
  return (
    value === "2-3" ||
    value === "3-4" ||
    value === "4-5" ||
    value === "5-6"
  );
}


function isLearnerLanguage(
  value: string
): value is LearnerLanguage {
  return (
    value === "ms" ||
    value === "en"
  );
}
"@
}

Write-Utf8NoBom -Path $deviceServicePath -Content $deviceService


# ============================================================
# Migration: create only if missing. Dry-run later.
# ============================================================

Write-Step "Ensuring learner runtime-profile Supabase migration exists"

$migrationDir =
  Join-Path $repoRoot "supabase\migrations"

New-Item -ItemType Directory -Force -Path $migrationDir | Out-Null

$existingMigration =
  Get-ChildItem $migrationDir -Filter "*.sql" |
  Where-Object {
    (Get-Content $_.FullName -Raw) -match "get_learner_runtime_profile"
  } |
  Select-Object -First 1

if (-not $existingMigration) {
  $migrationPath =
    Join-Path $migrationDir "20260820043100_learner_runtime_profile.sql"

  $migration = @"
create or replace function
  public.get_learner_runtime_profile(
    p_device_id uuid,
    p_device_token text
  )
returns table (
  child_id uuid,
  age_band text,
  preferred_language text
)
language plpgsql
security definer
set search_path = ''
as `$`$
declare
  v_device
    public.learner_devices%rowtype;
begin

  v_device :=
    private.get_valid_learner_device(
      p_device_id,
      p_device_token
    );

  return query
  select
    c.id,
    c.age_band,
    c.preferred_language
  from
    public.children as c
  where
    c.id =
      v_device.child_id;

end;
`$`$;


revoke all
on function
  public.get_learner_runtime_profile(
    uuid,
    text
  )
from public, authenticated;


grant execute
on function
  public.get_learner_runtime_profile(
    uuid,
    text
  )
to anon;
"@

  Write-Utf8NoBom -Path $migrationPath -Content $migration
  Write-Host "Created migration: $migrationPath" -ForegroundColor Green
}
else {
  Write-Host "Existing learner runtime-profile migration found." -ForegroundColor Green
}


# ============================================================
# Reconcile ActivityPlayer.
# ============================================================

Write-Step "Reconciling ActivityPlayer"

Backup-File $playerPath
$player = Get-Text $playerPath

# Add offline imports if missing.
if (-not $player.Contains("getCachedLearnerRuntimeProfile")) {
  $anchor = @"
  getLatestIncompleteSession,
  getLearnerDevice,
  processPendingSessions,
"@

  $replacement = @"
  getCachedLearnerRuntimeProfile,
  getLatestIncompleteSession,
  getLearnerDevice,
  getLearnerJourneyState,
  processPendingSessions,
  recordCompletedJourneyActivity,
  saveLearnerRuntimeProfile,
"@

  if (-not $player.Contains($anchor)) {
    throw "Could not safely reconcile the @akal-budi/offline import in ActivityPlayer.tsx"
  }

  $player = $player.Replace($anchor, $replacement)
}
else {
  if (-not $player.Contains("getLearnerJourneyState")) {
    $player = $player.Replace(
      "  getLearnerDevice,",
      "  getLearnerDevice,`r`n  getLearnerJourneyState,"
    )
  }

  if (-not $player.Contains("recordCompletedJourneyActivity")) {
    $player = $player.Replace(
      "  processPendingSessions,",
      "  processPendingSessions,`r`n  recordCompletedJourneyActivity,"
    )
  }
}

# Add runtime profile service import if missing.
if (-not $player.Contains("getLearnerRuntimeProfile")) {
  $importAnchor = @"
import {
  localSyncProvider
} from "../../services/localSyncProvider";
"@

  $newImport = @"
import {
  getLearnerRuntimeProfile,
  type LearnerAgeBand
} from "../../services/deviceActivationService";

import {
  localSyncProvider
} from "../../services/localSyncProvider";
"@

  if (-not $player.Contains($importAnchor)) {
    throw "Could not safely add the deviceActivationService import."
  }

  $player = $player.Replace($importAnchor, $newImport)
}

# Add selector import if missing.
if (-not $player.Contains('from "./selectLearnerActivity"')) {
  $resolverImport = @"
import {
  resolveRuntimeActivity
} from "./resolvePlayableActivity";
"@

  $resolverPlusSelector = @"
import {
  resolveRuntimeActivity
} from "./resolvePlayableActivity";

import {
  selectLearnerActivity
} from "./selectLearnerActivity";
"@

  if (-not $player.Contains($resolverImport)) {
    throw "Could not safely add selectLearnerActivity import."
  }

  $player = $player.Replace($resolverImport, $resolverPlusSelector)
}

# If the player is still hard-coded, stop here rather than guessing a large rewrite.
if ($player.Contains("DEFAULT_ACTIVITY_ID")) {
  throw @"
ActivityPlayer.tsx is still using DEFAULT_ACTIVITY_ID.
The prerequisite files have now been rebuilt safely, but the player shell is older than expected.

Please send the current ActivityPlayer.tsx after this script finishes creating prerequisites, and I will provide one final whole-file reconciled player.
"@
}

# Upgrade old selector call if it exists.
$player = $player.Replace(
  "selectLearnerActivity(`r`n          profile.ageBand`r`n        )",
  "selectLearnerActivity({`r`n          ageBand:`r`n            profile.ageBand,`r`n`r`n          lastCompletedActivityId:`r`n            null`r`n        })"
)

# Record journey after completion if not already there.
if (-not $player.Contains("recordCompletedJourneyActivity(")) {
  $completionAnchor = @"
      await completeLocalSession(
        sessionId,
        result
      );
"@

  $completionReplacement = @"
      await completeLocalSession(
        sessionId,
        result
      );


      await recordCompletedJourneyActivity(
        activity.id
      );
"@

  if ($player.Contains($completionAnchor)) {
    $player = $player.Replace($completionAnchor, $completionReplacement)
  }
}

Write-Utf8NoBom -Path $playerPath -Content $player


# ============================================================
# Tests for new repositories.
# ============================================================

Write-Step "Creating offline cache tests"

$runtimeProfileTestPath =
  Join-Path $repoRoot "packages\offline\src\__tests__\learnerRuntimeProfile.repository.test.ts"

$runtimeProfileTests = @"
import "fake-indexeddb/auto";

import {
  beforeEach,
  describe,
  expect,
  it
} from "vitest";

import {
  resetDatabaseForTests
} from "../database";

import {
  clearLearnerRuntimeProfile,
  getCachedLearnerRuntimeProfile,
  saveLearnerRuntimeProfile
} from "../learnerRuntimeProfile.repository";


describe(
  "learner runtime profile cache",
  () => {

    beforeEach(
      async () => {
        await resetDatabaseForTests();
      }
    );

    it(
      "stores and retrieves the minimal profile",
      async () => {
        await saveLearnerRuntimeProfile({
          childId:
            "child-123",

          ageBand:
            "3-4",

          preferredLanguage:
            "ms",

          validatedAt:
            123456
        });

        expect(
          await getCachedLearnerRuntimeProfile()
        ).toEqual({
          childId:
            "child-123",

          ageBand:
            "3-4",

          preferredLanguage:
            "ms",

          validatedAt:
            123456
        });
      }
    );

    it(
      "clears the profile",
      async () => {
        await saveLearnerRuntimeProfile({
          childId:
            "child-123",

          ageBand:
            "3-4",

          preferredLanguage:
            "ms",

          validatedAt:
            123456
        });

        await clearLearnerRuntimeProfile();

        expect(
          await getCachedLearnerRuntimeProfile()
        ).toBeNull();
      }
    );

  }
);
"@

Write-Utf8NoBom -Path $runtimeProfileTestPath -Content $runtimeProfileTests


$journeyTestPath =
  Join-Path $repoRoot "packages\offline\src\__tests__\learningJourney.repository.test.ts"

$journeyTests = @"
import "fake-indexeddb/auto";

import {
  beforeEach,
  describe,
  expect,
  it
} from "vitest";

import {
  resetDatabaseForTests
} from "../database";

import {
  clearLearnerJourneyState,
  getLearnerJourneyState,
  recordCompletedJourneyActivity
} from "../learningJourney.repository";


describe(
  "learner journey repository",
  () => {

    beforeEach(
      async () => {
        await resetDatabaseForTests();
      }
    );

    it(
      "starts empty",
      async () => {
        expect(
          await getLearnerJourneyState()
        ).toEqual({
          lastCompletedActivityId:
            null,

          completedSessionCount:
            0,

          updatedAt:
            0
        });
      }
    );

    it(
      "records completion",
      async () => {
        const state =
          await recordCompletedJourneyActivity(
            "warna-bunga-raya-001"
          );

        expect(
          state.lastCompletedActivityId
        ).toBe(
          "warna-bunga-raya-001"
        );

        expect(
          state.completedSessionCount
        ).toBe(1);
      }
    );

    it(
      "clears state",
      async () => {
        await recordCompletedJourneyActivity(
          "warna-bunga-raya-001"
        );

        await clearLearnerJourneyState();

        expect(
          await getLearnerJourneyState()
        ).toEqual({
          lastCompletedActivityId:
            null,

          completedSessionCount:
            0,

          updatedAt:
            0
        });
      }
    );

  }
);
"@

Write-Utf8NoBom -Path $journeyTestPath -Content $journeyTests


# ============================================================
# Validation
# ============================================================

Write-Step "Running repository typecheck"

$typecheck = Invoke-Logged -Name "pnpm typecheck" -Command { pnpm typecheck }

if (-not $typecheck.Passed) {
  Save-Diagnostic -Stage "typecheck" -Output $typecheck.Output
  throw "Typecheck failed. See the diagnostic log."
}


Write-Step "Running tests"

$tests = Invoke-Logged -Name "pnpm test" -Command { pnpm test }

if (-not $tests.Passed) {
  Save-Diagnostic -Stage "test" -Output $tests.Output
  throw "Tests failed. See the diagnostic log."
}


Write-Step "Running production build"

$build = Invoke-Logged -Name "pnpm build" -Command { pnpm build }

if (-not $build.Passed) {
  Save-Diagnostic -Stage "build" -Output $build.Output
  throw "Build failed. See the diagnostic log."
}


Write-Step "Running Supabase migration dry-run"

$dryRun = Invoke-Logged `
  -Name "pnpm supabase db push --dry-run" `
  -Command {
    pnpm supabase db push --dry-run
  }

if (-not $dryRun.Passed) {
  Save-Diagnostic -Stage "supabase-dry-run" -Output $dryRun.Output
  throw "Supabase dry-run failed. Database was not changed."
}


Write-Step "Running git diff --check"

$diffCheck = Invoke-Logged `
  -Name "git diff --check" `
  -Command {
    git diff --check
  }

if (-not $diffCheck.Passed) {
  Save-Diagnostic -Stage "git-diff-check" -Output $diffCheck.Output
  throw "git diff --check failed."
}


if ($Commit) {
  Write-Step "Committing validated reconciliation"

  git add .
  git commit -m "feat: reconcile offline learner runtime and journey"

  if ($LASTEXITCODE -ne 0) {
    throw "Git commit failed."
  }
}


Write-Host ""
