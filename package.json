{
  "name": "hibeya-akal-budi",
  "private": true,
  "version": "0.1.0",
  "description": "HIBEYA Akal Budi ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â Membina Akal. Menyemai Budi.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:run": "turbo run test -- --run",
    "clean": "turbo run clean",
    "curriculum:validate": "node tools/curriculum/validate.mjs",
    "content:check": "node tools/content-compiler/compile.mjs --check",
    "curriculum:sources:validate": "node tools/curriculum/validate-sources.mjs",
    "curriculum:review:list": "node tools/curriculum/review-mapping.mjs list",
    "design:validate": "node tools/design/validate.mjs",
    "storybook": "pnpm --filter ui-storybook storybook",
    "storybook:build": "pnpm --filter ui-storybook build-storybook",
    "design:apps:check": "pnpm --filter learner-web typecheck && pnpm --filter parent-web build",
    "design:apps:validate": "node tools/design/validate-app-adoption.mjs",
    "qa:browsers:install": "playwright install chromium",
    "qa:a11y": "playwright test -c tools/visual-regression/playwright.config.ts tools/visual-regression/tests/accessibility.spec.ts",
    "qa:visual": "playwright test -c tools/visual-regression/playwright.config.ts tools/visual-regression/tests/visual.spec.ts",
    "qa:visual:update": "playwright test -c tools/visual-regression/playwright.config.ts tools/visual-regression/tests/visual.spec.ts --update-snapshots",
    "qa:ui": "pnpm storybook:build && pnpm qa:a11y && pnpm qa:visual",
    "assets:bootstrap": "node tools/assets/bootstrap-manifests.mjs",
    "assets:validate": "node tools/assets/validate-provenance.mjs",
    "assets:commercial:validate": "node tools/assets/validate-commercial.mjs",
    "illustration:validate": "node tools/assets/validate-illustration-system.mjs",
    "assets:queue": "node tools/assets/generate-production-queue.mjs",
    "assets:pipeline:validate": "node tools/assets/validate-production-pipeline.mjs",
    "assets:approve": "node tools/assets/approve-asset.mjs",
    "assets:first-batch:prepare": "node tools/assets/prepare-first-batch-review.mjs",
    "assets:first-batch:validate": "node tools/assets/validate-first-batch.mjs",
    "assets:first-batch:approve": "node tools/assets/approve-first-batch.mjs",
    "assets:families:compile": "node tools/assets/compile-families.mjs",
    "assets:families:check": "node tools/assets/compile-families.mjs --check",
    "assets:families:validate": "node tools/assets/validate-families.mjs",
    "assets:families:report": "node tools/assets/report-families.mjs",
    "assets:families:qa": "pnpm assets:families:validate && pnpm assets:families:check && pnpm assets:validate && pnpm assets:pipeline:validate",
    "assets:runtime:migrate": "node tools/assets/migrate-runtime-metadata.mjs",
    "assets:runtime:compile": "node tools/assets/compile-commercial-registry.mjs",
    "assets:runtime:check": "node tools/assets/compile-commercial-registry.mjs --check",
    "assets:runtime:validate": "node tools/assets/validate-commercial-registry.mjs",
    "assets:runtime:qa": "pnpm assets:runtime:check && pnpm assets:runtime:validate && pnpm assets:commercial:validate",
    "assets:hibiscus-batch:prepare": "node tools/assets/prepare-hibiscus-batch-review.mjs",
    "assets:hibiscus-batch:validate": "node tools/assets/validate-hibiscus-batch.mjs",
    "assets:hibiscus-batch:approve": "node tools/assets/approve-hibiscus-batch.mjs",
    "assets:hibiscus-batch:finalise": "pnpm assets:hibiscus-batch:approve I_REVIEWED_VISUALS_AND_CULTURE && pnpm assets:families:validate && pnpm assets:families:compile && pnpm assets:families:check && pnpm assets:runtime:compile && pnpm assets:runtime:check && pnpm assets:runtime:validate && pnpm assets:commercial:validate",
    "assets:visual-baseline:audit": "node tools/assets/audit-production-visual-baseline.mjs",
    "assets:visual-baseline:review": "pnpm assets:visual-baseline:audit && pnpm storybook:build",
    "assets:formats:validate": "node tools/assets/validate-runtime-formats.mjs",
    "assets:ingest": "node tools/assets/ingest-asset.mjs",
    "assets:formats:qa": "pnpm assets:formats:validate && pnpm assets:runtime:check && pnpm assets:runtime:validate",
    "assets:hibiscus:intake": "node tools/assets/inspect-hibiscus-intake.mjs",
    "assets:hibiscus:ingest": "node tools/assets/ingest-hibiscus-batch.mjs",
    "assets:hibiscus:approve": "node tools/assets/approve-hibiscus-v2.mjs",
    "assets:hibiscus:finalise": "pnpm assets:hibiscus:approve I_REVIEWED_VISUALS_RIGHTS_AND_CULTURE && pnpm assets:runtime:compile && pnpm assets:runtime:check && pnpm assets:runtime:validate && pnpm assets:commercial:validate",
    "assets:hibiscus:optimise": "node tools/assets/optimise-hibiscus-runtime.mjs",
    "assets:hibiscus:optimise:validate": "node tools/assets/validate-hibiscus-runtime-optimisation.mjs",
    "assets:hibiscus:budget": "node tools/assets/report-hibiscus-image-budget.mjs",
    "assets:hibiscus:runtime:qa": "pnpm assets:hibiscus:optimise:validate && pnpm assets:formats:validate && pnpm assets:runtime:check && pnpm assets:runtime:validate",
    "assets:vault:build": "node tools/assets/build-asset-vault.mjs",
    "assets:vault:validate": "node tools/assets/validate-asset-vault.mjs",
    "assets:vault:report": "node tools/assets/report-asset-vault.mjs",
    "assets:vault:qa": "pnpm assets:vault:validate && pnpm assets:runtime:check && pnpm assets:runtime:validate",
    "qa:journey": "playwright test -c tools/visual-regression/playwright.config.ts tools/visual-regression/tests/learner-journey.spec.ts",
    "content:sequence:validate": "node tools/content-compiler/validate-sequencing.mjs",
    "content:eligibility:validate": "node tools/content-compiler/validate-eligibility.mjs",
    "content:coverage:validate": "node tools/content-compiler/validate-coverage.mjs",
    "mastery:validate": "pnpm --filter @akal-budi/learning-insights test && pnpm --filter @akal-budi/offline test && pnpm --filter @akal-budi/content-library test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.112.3",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.3",
    "supabase": "^2.115.0",
    "turbo": "^2.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
